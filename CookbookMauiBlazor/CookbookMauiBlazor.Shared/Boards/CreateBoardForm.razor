<EditForm Model="_model" OnValidSubmit="CreateBoardAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Board name</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <button class="btn btn-primary" type="submit">Create board</button>
</EditForm>

@code {
    [Inject]
    private BoardViewModel BoardViewModel { get; set; } = default!;

    [Parameter, EditorRequired]
    public string OwnerUserId { get; set; } = string.Empty;

    private CreateBoardModel _model = new();

    private async Task CreateBoardAsync()
    {
        await BoardViewModel.CreateBoardAsync(OwnerUserId, _model.Name);
        _model = new();
    }

    private sealed class CreateBoardModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
    }
}
