@using global::Cookbook.Shared.Boards
@using CookbookMauiBlazor.Shared.Services
@using Microsoft.Extensions.Logging
@using System.Collections.Generic

@if (IsOpen)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share Board</h5>
                    <button type="button" class="btn-close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    @if (_isLoading)
                    {
                        <p>Loading...</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Search users</label>
                            <input type="text" class="form-control" placeholder="Search by name..."
                                   value="@_searchQuery" @oninput="OnSearchChangedAsync" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @_errorMessage
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
                            </div>
                        }

                        <div class="mb-3">
                            <h6>Current Collaborators</h6>
                            @if (_collaborators.Count == 0)
                            {
                                <p class="text-muted small">No one else has access yet.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-sm">
                                    @foreach (var collaborator in _collaborators)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div>@collaborator.DisplayName</div>
                                                <small class="text-muted">@collaborator.Role</small>
                                            </div>
                                            @if (collaborator.UserId != _boardOwnerId && _canManageSharing)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RemoveCollaboratorAsync(collaborator.UserId)">
                                                    Remove
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div>
                            <h6>Add Users</h6>
                            @if (_availableUsers.Count == 0)
                            {
                                <p class="text-muted small">No users available.</p>
                            }
                            else
                            {
                                <p class="text-muted small">Showing all available users.</p>
                                <div class="list-group list-group-sm mb-3" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var user in _availableUsers)
                                    {
                                        var isSelected = _selectedUserIds.Contains(user.UserId);
                                        <label class="list-group-item">
                                            <input type="checkbox" checked="@isSelected"
                                                   @onchange="(ChangeEventArgs args) => ToggleUserSelection(user.UserId, (bool?)args.Value ?? false)" />
                                            <span class="ms-2">@user.DisplayName</span>
                                        </label>
                                    }
                                </div>

                                @if (_selectedUserIds.Count > 0)
                                {
                                    <div>
                                        <label class="form-label">Role</label>
                                        <select class="form-select" @bind="_selectedRole">
                                            <option value="Viewer">Viewer</option>
                                            <option value="Editor">Editor</option>
                                        </select>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Close</button>
                    <button type="button" class="btn btn-primary" @onclick="ShareAsync"
                            disabled="@(_selectedUserIds.Count == 0 || _isSaving || !_canManageSharing)">
                        @(_isSaving ? "Sharing..." : "Share")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject]
    private IUserService UserService { get; set; } = default!;

    [Inject]
    private ILogger<ShareBoardDialog> Logger { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter]
    public string BoardOwnerId { get; set; } = string.Empty;

    [Parameter]
    public string CurrentUserId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnShared { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private List<BoardCollaborator> _collaborators = [];
    private List<UserSummary> _availableUsers = [];
    private HashSet<string> _selectedUserIds = [];
    private string _searchQuery = string.Empty;
    private string _selectedRole = "Viewer";
    private bool _isLoading;
    private bool _isSaving;
    private string _errorMessage = string.Empty;
    private string _boardOwnerId = string.Empty;
    private bool _canManageSharing;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && BoardId != Guid.Empty)
        {
            await LoadCollaboratorsAsync();
            await LoadUsersAsync();
        }
    }

    private async Task LoadCollaboratorsAsync()
    {
        _isLoading = true;
        _selectedUserIds.Clear();
        _errorMessage = string.Empty;
        _boardOwnerId = BoardOwnerId;

        try
        {
            _collaborators = (await UserService.GetBoardCollaboratorsAsync(BoardId)).ToList();
            _canManageSharing = string.Equals(CurrentUserId, BoardOwnerId, StringComparison.OrdinalIgnoreCase)
                || _collaborators.Any(c => string.Equals(c.UserId, CurrentUserId, StringComparison.OrdinalIgnoreCase)
                    && IsShareManagerRole(c.Role));
        }
        catch
        {
            _errorMessage = "Failed to load collaborators. Please try again.";
            _canManageSharing = string.Equals(CurrentUserId, BoardOwnerId, StringComparison.OrdinalIgnoreCase);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadUsersAsync(CancellationToken cancellationToken = default)
    {
        Logger.LogInformation("Loading share-board user search results for board {BoardId} and query '{SearchQuery}'.", BoardId, _searchQuery);

        _errorMessage = string.Empty;

        try
        {
            var allUsers = (await UserService.SearchAsync(_searchQuery, cancellationToken)).ToList();
            var existingUserIds = _collaborators.Select(c => c.UserId).ToHashSet();
            _availableUsers = allUsers
                .Where(u => !existingUserIds.Contains(u.UserId) && u.UserId != CurrentUserId)
                .ToList();

            Logger.LogInformation(
                "Share-board search for board {BoardId} returned {ApiCount} users and {FilteredCount} selectable users after filtering collaborators/current user.",
                BoardId,
                allUsers.Count,
                _availableUsers.Count);
        }
        catch (OperationCanceledException)
        {
            // Search was cancelled by a new keystroke.
        }
        catch
        {
            _availableUsers = [];
            _errorMessage = "Failed to search users. Please try again.";
        }
    }

    private async Task OnSearchChangedAsync(ChangeEventArgs args)
    {
        _searchQuery = args.Value?.ToString() ?? string.Empty;
        _selectedUserIds.Clear();

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            await LoadUsersAsync(token);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private void ToggleUserSelection(string userId, bool selected)
    {
        if (selected)
            _selectedUserIds.Add(userId);
        else
            _selectedUserIds.Remove(userId);
    }

    private async Task ShareAsync()
    {
        if (_selectedUserIds.Count == 0) return;
        if (!_canManageSharing)
        {
            _errorMessage = "You do not have permission to share this board.";
            return;
        }

        _isSaving = true;
        _errorMessage = string.Empty;

        try
        {
            await UserService.ShareBoardAsync(BoardId, _selectedUserIds, CurrentUserId, _selectedRole);
            await OnShared.InvokeAsync();
            await CloseAsync();
        }
        catch
        {
            _errorMessage = "Failed to share board. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RemoveCollaboratorAsync(string userId)
    {
        if (!_canManageSharing)
        {
            _errorMessage = "You do not have permission to modify collaborators.";
            return;
        }

        try
        {
            await UserService.RemovePermissionAsync(BoardId, userId);
            await LoadCollaboratorsAsync();
        }
        catch
        {
            _errorMessage = "Failed to remove collaborator. Please try again.";
        }
    }

    private async Task CloseAsync()
    {
        _searchQuery = string.Empty;
        _selectedUserIds.Clear();
        _availableUsers.Clear();
        _selectedRole = "Viewer";
        _errorMessage = string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
        await OnClose.InvokeAsync();
    }

    private static bool IsShareManagerRole(string role) => role is "Manager" or "Admin";
}
