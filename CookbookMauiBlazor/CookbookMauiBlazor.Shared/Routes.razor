@using Microsoft.AspNetCore.Components.Authorization
@using System
@inject NavigationManager Navigation
@inject CookbookMauiBlazor.Shared.Services.IAuthService AuthService

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Layout.MainLayout).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <h1>Sign in required</h1>
                    <p>
                        <button class="btn btn-link p-0" @onclick="HandleSignIn">Sign in</button> to continue.
                    </p>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    private string BuildRedirectUri()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(relativePath))
        {
            return "/";
        }

        return $"/{Uri.EscapeDataString(relativePath)}";
    }

    private Task HandleSignIn()
    {
        var redirectUri = BuildRedirectUri();
        return AuthService.SignInAsync(redirectUri);
    }
}
