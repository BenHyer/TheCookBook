@page "/boards"
@using CookbookMauiBlazor.Shared.Boards

<PageTitle>Boards</PageTitle>

<h1>Boards</h1>

<CreateBoardForm OwnerUserId="@_ownerUserId" OnCreated="HandleBoardCreated" />

<hr />

<BoardList OwnerUserId="@_ownerUserId" ReloadToken="@_reloadToken" />

@code {
    private readonly string _ownerUserId = "demo-user";
    private int _reloadToken;

    private void HandleBoardCreated()
    {
        _reloadToken++;
    }
}
