@page "/boards"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CookbookMauiBlazor.Shared.Boards
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Boards</PageTitle>

<h1>Boards</h1>

@if (string.IsNullOrEmpty(_ownerUserId))
{
    <div class="alert alert-warning">Could not resolve user ID from token. Claims available: @_debugClaims</div>
}
else
{
    <p class="text-muted small">Signed in as: @_ownerUserId</p>
    <CreateBoardForm OwnerUserId="@_ownerUserId" OnCreated="HandleBoardCreated" />
    <hr />
    <BoardList OwnerUserId="@_ownerUserId" ReloadToken="@_reloadToken" />
}

@code {
    private string _ownerUserId = string.Empty;
    private string _debugClaims = string.Empty;
    private int _reloadToken;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _ownerUserId =
            user.FindFirst("oid")?.Value
            ?? user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
            ?? user.FindFirst("sub")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? string.Empty;

        if (string.IsNullOrEmpty(_ownerUserId))
            _debugClaims = string.Join(", ", user.Claims.Select(c => c.Type));
    }

    private void HandleBoardCreated()
    {
        _reloadToken++;
    }
}
