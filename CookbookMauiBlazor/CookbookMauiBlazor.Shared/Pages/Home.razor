@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using CookbookMauiBlazor.Shared.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService

<PageTitle>Cookbook</PageTitle>

<div class="text-center">
    <h1>Welcome to Ultimate Cookbook!</h1>
    <p class="text-muted">Manage boards and recipes from one place.</p>
</div>

@if (_requiresSignIn)
{
    <div class="alert alert-info mt-4">
        <div>Sign in or create an account to start saving recipes.</div>
        <button class="btn btn-primary mt-2" @onclick="SignInAsync">Sign in</button>
    </div>
}

<div class="d-flex flex-column flex-md-row gap-2 mt-4">
    <NavLink class="btn btn-primary" href="cookbook">Create a recipe</NavLink>
    <NavLink class="btn btn-outline-primary" href="boards">Open Boards</NavLink>
    <NavLink class="btn btn-outline-primary" href="cookbook">Open Cookbook</NavLink>
</div>

<div class="mt-4">
    <h5>How it works</h5>
    <p>
        Create recipes and boards to store digitally. Boards are like recipe playlists.
        You can create just for you or for you to share with others.
    </p>
</div>

@code {
    private bool _requiresSignIn;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _requiresSignIn = !user.Identity?.IsAuthenticated ?? true;
    }

    private Task SignInAsync() => AuthService.SignInAsync("/");
}
