@page "/"
@using System.ComponentModel
@using CookbookMauiBlazor.Shared.Viewmodels
@inject HomePageViewModel ViewModel
@implements IDisposable

<PageTitle>Cookbook</PageTitle>

<div class="text-center">
    <h1>Welcome to Ultimate Cookbook!</h1>
    <p class="text-muted">Manage boards and recipes from one place.</p>
</div>

@if (ViewModel.RequiresSignIn)
{
    <div class="alert alert-info mt-4">
        <div>Sign in or create an account to start saving recipes.</div>
        <button class="btn btn-primary mt-2" @onclick="ViewModel.SignInAsync">Sign in</button>
    </div>
}

<div class="d-flex flex-column flex-md-row gap-2 mt-4">
    <NavLink class="btn btn-primary" href="cookbook">Create a recipe</NavLink>
    <NavLink class="btn btn-outline-primary" href="boards">Open Boards</NavLink>
    <NavLink class="btn btn-outline-primary" href="cookbook">Open Cookbook</NavLink>
</div>

<div class="mt-4">
    <h5>How it works</h5>
    <p>
        Create recipes and boards to store digitally. Boards are like recipe playlists.
        You can create just for you or for you to share with others.
    </p>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        await ViewModel.InitializeAsync();
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
    }
}
