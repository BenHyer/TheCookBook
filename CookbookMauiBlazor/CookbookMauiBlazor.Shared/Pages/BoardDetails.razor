@page "/boards/{BoardId:guid}"
@using System.ComponentModel
@using Microsoft.AspNetCore.Components.Authorization
@using global::Cookbook.Shared.Boards
@using CookbookMauiBlazor.Shared.Boards
@using BoardDetailsDto = global::Cookbook.Shared.Boards.BoardDetails
@using CookbookMauiBlazor.Shared.Models
@using CookbookMauiBlazor.Shared.Services
@using CookbookMauiBlazor.Shared.Viewmodels
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject BoardDetailsViewModel ViewModel
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBoardService BoardService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@(ViewModel.BoardDetails?.Name ?? "Board")</PageTitle>

@if (ViewModel.Loading)
{
    <p>Loading board...</p>
}
else if (ViewModel.BoardDetails is null)
{
    <div class="alert alert-warning">Board not found.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1>@ViewModel.BoardDetails.Name</h1>
            @if (!string.IsNullOrWhiteSpace(ViewModel.BoardDetails.Description))
            {
                <p class="text-muted">@ViewModel.BoardDetails.Description</p>
            }
            <div class="text-muted small">@ViewModel.BoardDetails.RecipeCount recipe(s)</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary" @onclick="ViewModel.ToggleAddPanelAsync">Add recipes</button>
            @if (_isOwner)
            {
                <button class="btn btn-outline-primary" @onclick="OpenShareDialog">Share</button>
                <button class="btn btn-outline-danger" @onclick="OpenDeleteDialog">Delete</button>
            }
        </div>
    </div>

    <ShareBoardDialog BoardId="BoardId" BoardOwnerId="ViewModel.BoardDetails.OwnerUserId"
                      CurrentUserId="@_currentUserId" IsOpen="@_shareDialogOpen"
                      OnClose="CloseShareDialog" OnShared="OnBoardShared" />

    <ConfirmDeleteBoardDialog IsOpen="@_deleteDialogOpen"
                              BoardName="@(ViewModel.BoardDetails.Name)"
                              IsDeleting="@_isDeleting"
                              ErrorMessage="@_deleteError"
                              OnConfirm="ConfirmDeleteAsync"
                              OnCancel="CloseDeleteDialog" />

    @if (ViewModel.ShowAddPanel)
    {
        <div class="card my-4">
            <div class="card-body">
                <h5 class="card-title">Add recipes to this board</h5>
                @if (!string.IsNullOrWhiteSpace(ViewModel.AddError))
                {
                    <div class="alert alert-danger">@ViewModel.AddError</div>
                }
                <div class="mb-3">
                    <label class="form-label">Search recipes</label>
                    <input class="form-control" @bind="ViewModel.SearchText" @bind:event="oninput"
                           placeholder="Search by name" />
                </div>

                @if (ViewModel.AvailableRecipes.Count == 0)
                {
                    <p class="text-muted">No recipes available to add yet.</p>
                }
                else
                {
                    <div class="border rounded p-2" style="max-height: 320px; overflow-y: auto;">
                        @foreach (var recipe in ViewModel.FilteredAvailableRecipes())
                        {
                            var checkboxId = $"recipe-{recipe.Id}";
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@checkboxId"
                                       checked="@ViewModel.SelectedRecipeIds.Contains(recipe.Id)"
                                       @onchange="(args) => ViewModel.ToggleSelection(recipe.Id, args.Value is bool isChecked && isChecked)" />
                                <label class="form-check-label" for="@checkboxId">@recipe.Title</label>
                            </div>
                        }
                    </div>
                }

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" @onclick="ViewModel.AddSelectedRecipesAsync"
                            disabled="@(ViewModel.Adding || ViewModel.SelectedRecipeIds.Count == 0)">
                        @(ViewModel.Adding ? "Adding..." : "Add selected")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ViewModel.CloseAddPanel"
                            disabled="@ViewModel.Adding">Cancel</button>
                </div>
            </div>
        </div>
    }

    <h3 class="mt-4">Recipes</h3>
    @if (ViewModel.BoardRecipes.Count == 0)
    {
        <p class="text-muted">No recipes on this board yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var recipe in ViewModel.BoardRecipes)
            {
                <div class="col">
                    <NavLink class="card h-100 text-decoration-none" href="@($"/recipes/{recipe.Id}")">
                        @if (!string.IsNullOrWhiteSpace(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Title"
                                 style="height:200px;object-fit:cover;" />
                        }
                        <div class="card-body">
                            <h5 class="card-title text-body">@recipe.Title</h5>
                            @if (!string.IsNullOrWhiteSpace(recipe.Description))
                            {
                                <p class="card-text text-muted small">@recipe.Description</p>
                            }
                        </div>
                    </NavLink>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    private bool _shareDialogOpen;
    private bool _deleteDialogOpen;
    private bool _isDeleting;
    private string _deleteError = string.Empty;
    private bool _isOwner;
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        await InitializeUserAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ViewModel.LoadBoardAsync(BoardId);
        _isOwner = _currentUserId == ViewModel.BoardDetails?.OwnerUserId;
    }

    private async Task InitializeUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = user.FindFirst("oid")?.Value ??
            user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value ??
            user.FindFirst("sub")?.Value ?? string.Empty;
    }

    private void OpenShareDialog()
    {
        _shareDialogOpen = true;
    }

    private async Task CloseShareDialog()
    {
        _shareDialogOpen = false;
    }

    private async Task OnBoardShared()
    {
        _shareDialogOpen = false;
    }

    private void OpenDeleteDialog()
    {
        _deleteError = string.Empty;
        _deleteDialogOpen = true;
    }

    private void CloseDeleteDialog()
    {
        _deleteDialogOpen = false;
        _deleteError = string.Empty;
    }

    private async Task ConfirmDeleteAsync()
    {
        _isDeleting = true;
        _deleteError = string.Empty;

        try
        {
            await BoardService.DeleteAsync(BoardId);
            NavigationManager.NavigateTo("/boards");
        }
        catch (Exception ex)
        {
            _deleteError = $"Failed to delete the board: {ex.Message}";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
    }
}
