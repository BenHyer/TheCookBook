@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel
@using Microsoft.AspNetCore.Components.Forms
@using CookbookMauiBlazor.Shared.Viewmodels

@attribute [Authorize]
@inject ProfilePageViewModel ViewModel
@implements IDisposable

<PageTitle>Profile</PageTitle>

<div class="profile-page">
    <h1>My Profile</h1>

    @if (!ViewModel.ProfilesEnabled)
    {
        <p>The account page is currently disabled.</p>
    }
    else if (ViewModel.Loading)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="profile-avatar-section mb-4">
            @if (!string.IsNullOrEmpty(ViewModel.PictureUrl))
            {
                <img src="@ViewModel.PictureUrl" alt="Profile picture" class="profile-avatar-large" />
            }
            else
            {
                <div class="profile-avatar-placeholder-large">
                    <span class="bi bi-person-fill"></span>
                </div>
            }

            <div class="mt-2">
                <InputFile OnChange="ViewModel.HandlePictureSelectedAsync"
                           accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" style="max-width:320px;" />
                @if (ViewModel.PictureUploading)
                {
                    <small class="text-muted">Uploading...</small>
                }
                @if (!string.IsNullOrEmpty(ViewModel.PictureError))
                {
                    <small class="text-danger d-block">@ViewModel.PictureError</small>
                }
            </div>
        </div>

        <EditForm Model="ViewModel.ProfileModel" OnValidSubmit="ViewModel.SaveProfileAsync" class="profile-form">
            <DataAnnotationsValidator />

            <div class="mb-3" style="max-width:400px;">
                <label class="form-label">First Name</label>
                <InputText @bind-Value="ViewModel.ProfileModel.FirstName" class="form-control" />
                <ValidationMessage For="@(() => ViewModel.ProfileModel.FirstName)" />
            </div>

            <div class="mb-3" style="max-width:400px;">
                <label class="form-label">Last Name</label>
                <InputText @bind-Value="ViewModel.ProfileModel.LastName" class="form-control" />
                <ValidationMessage For="@(() => ViewModel.ProfileModel.LastName)" />
            </div>

            <div class="mb-3" style="max-width:400px;">
                <label class="form-label">Display Name</label>
                <InputText @bind-Value="ViewModel.ProfileModel.DisplayName" class="form-control" />
                <ValidationMessage For="@(() => ViewModel.ProfileModel.DisplayName)" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@ViewModel.Saving">
                @(ViewModel.Saving ? "Saving..." : "Save Changes")
            </button>

            @if (ViewModel.SaveSuccess)
            {
                <span class="ms-3 text-success">Saved!</span>
            }
            @if (!string.IsNullOrEmpty(ViewModel.SaveError))
            {
                <span class="ms-3 text-danger">@ViewModel.SaveError</span>
            }
        </EditForm>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        await ViewModel.InitializeAsync();
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
    }
}
