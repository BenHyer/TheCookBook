@page "/cookbook"
@using System.ComponentModel
@using global::Cookbook.Shared.Boards
@using CookbookMauiBlazor.Shared.Models
@using CookbookMauiBlazor.Shared.Viewmodels
@inject CookbookViewModel ViewModel
@implements IDisposable

<PageTitle>Cookbook</PageTitle>

<h3>Cookbook</h3>

@if (ViewModel.RequiresSignIn)
{
    <div class="alert alert-info">
        <div>Sign in to create and view your recipes.</div>
        <button class="btn btn-primary mt-2" @onclick="ViewModel.SignInAsync">Sign in</button>
    </div>
}
else
{
    <div class="mb-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="ViewModel.ToggleForm" disabled="@(ViewModel.EditingRecipe is not null)">
            @(ViewModel.ShowForm ? "Cancel" : "+ New Recipe")
        </button>
        <button class="btn btn-outline-primary" @onclick="ViewModel.ToggleBoardAddPanelAsync"
                disabled="@(ViewModel.EditingRecipe is not null)">
            Add recipes to board
        </button>
        @if (ViewModel.EditingRecipe is not null)
        {
            <span class="text-muted align-self-center">Editing: @ViewModel.EditingRecipe.Title</span>
        }
    </div>

    @if (ViewModel.ShowBoardAddPanel)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Add recipes to a board</h5>
                @if (!string.IsNullOrWhiteSpace(ViewModel.BoardAddError))
                {
                    <div class="alert alert-danger">@ViewModel.BoardAddError</div>
                }
                <div class="mb-3">
                    <label class="form-label">Select board</label>
                    <InputSelect class="form-select" @bind-Value="ViewModel.SelectedBoardId">
                        <option value="">Choose a board</option>
                        @foreach (var board in ViewModel.Boards)
                        {
                            <option value="@board.Id">@board.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label">Search recipes</label>
                    <input class="form-control" @bind="ViewModel.BoardSearchText" @bind:event="oninput"
                           placeholder="Search by name" />
                </div>
                @if (ViewModel.Recipes.Count == 0)
                {
                    <p class="text-muted">No recipes available.</p>
                }
                else
                {
                    <div class="border rounded p-2" style="max-height: 320px; overflow-y: auto;">
                        @foreach (var recipe in ViewModel.FilteredBoardAddRecipes())
                        {
                            var checkboxId = $"board-add-recipe-{recipe.Id}";
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@checkboxId"
                                       checked="@ViewModel.SelectedBoardRecipeIds.Contains(recipe.Id)"
                                       @onchange="(args) => ViewModel.ToggleBoardSelection(recipe.Id, args.Value is bool isChecked && isChecked)" />
                                <label class="form-check-label" for="@checkboxId">@recipe.Title</label>
                            </div>
                        }
                    </div>
                }
                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" @onclick="ViewModel.AddRecipesToBoardAsync"
                            disabled="@(ViewModel.AddingToBoard || ViewModel.SelectedBoardRecipeIds.Count == 0 || ViewModel.SelectedBoardId is null)">
                        @(ViewModel.AddingToBoard ? "Adding..." : "Add selected")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ViewModel.CloseBoardAddPanel"
                            disabled="@ViewModel.AddingToBoard">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (ViewModel.EditingRecipe is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <EditRecipeForm Recipe="@ViewModel.EditingRecipe" OnSaved="ViewModel.HandleRecipeUpdated"
                                OnCanceled="ViewModel.CancelEdit" />
            </div>
        </div>
    }
    else if (ViewModel.ShowForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <NewRecipeForm OwnerUserId="@ViewModel.OwnerUserId" OnCreated="ViewModel.HandleRecipeCreated" />
            </div>
        </div>
    }

    @if (ViewModel.Loading)
    {
        <p>Loading recipes...</p>
    }
    else if (ViewModel.Recipes.Count == 0)
    {
        <p class="text-muted">No recipes yet. Add one above!</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var recipe in ViewModel.Recipes)
            {
                <div class="col">
                    <div class="card h-100 text-decoration-none" style="cursor:pointer;"
                         @onclick="() => ViewModel.NavigateToRecipe(recipe.Id)">
                        @if (!string.IsNullOrWhiteSpace(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Title"
                                 style="height:200px;object-fit:cover;" />
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title text-body">@recipe.Title</h5>
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        @onclick="() => ViewModel.StartEdit(recipe)" @onclick:stopPropagation="true">
                                    Edit
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(recipe.Description))
                            {
                                <p class="card-text text-muted small">@recipe.Description</p>
                            }
                            <div class="d-flex gap-3 small text-muted">
                                @if (!string.IsNullOrWhiteSpace(recipe.PrepTime))
                                {
                                    <span>Prep: @recipe.PrepTime</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(recipe.CookTime))
                                {
                                    <span>Cook: @recipe.CookTime</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(recipe.YieldServings))
                                {
                                    <span>Serves: @recipe.YieldServings</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        await ViewModel.InitializeAsync();
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
    }
}
