@page "/recipes/{RecipeId:int}"
@using System.ComponentModel
@using CookbookMauiBlazor.Shared.Models
@using CookbookMauiBlazor.Shared.Viewmodels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject RecipeDetailsViewModel ViewModel
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(ViewModel.Recipe?.Title ?? "Recipe")</PageTitle>

@if (ViewModel.Loading)
{
    <p>Loading recipe...</p>
}
else if (ViewModel.Recipe is null)
{
    <div class="alert alert-warning">Recipe not found.</div>
}
else if (ViewModel.Editing)
{
    <div class="mb-3">
        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ViewModel.CancelEdit">&#8592; Cancel editing</button>
    </div>
    <EditRecipeForm Recipe="ViewModel.Recipe" OnSaved="ViewModel.HandleSaved" OnCanceled="ViewModel.CancelEdit" />
}
else
{
    <div class="recipe-detail d-flex flex-column gap-4">

        <div class="d-flex justify-content-between align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="GoBack">&#8592; Back</button>
            @if (ViewModel.IsOwner)
            {
                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="ViewModel.StartEdit">Edit Recipe</button>
            }
        </div>

        <div>
            <h1 class="mb-1">@ViewModel.Recipe.Title</h1>
            @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.Description))
            {
                <p class="text-muted mb-0">@ViewModel.Recipe.Description</p>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.ImageUrl))
        {
            <img src="@ViewModel.Recipe.ImageUrl" class="rounded" alt="@ViewModel.Recipe.Title"
                 style="max-height:360px;max-width:100%;object-fit:cover;" />
        }

        @if (ViewModel.HasAnyTiming())
        {
            <div class="d-flex flex-wrap gap-2">
                @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.YieldServings))
                {
                    <span class="recipe-meta-pill">Serves: @ViewModel.Recipe.YieldServings</span>
                }
                @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.PrepTime))
                {
                    <span class="recipe-meta-pill">Prep: @ViewModel.Recipe.PrepTime</span>
                }
                @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.CookTime))
                {
                    <span class="recipe-meta-pill">Cook: @ViewModel.Recipe.CookTime</span>
                }
                @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.TotalTime))
                {
                    <span class="recipe-meta-pill">Total: @ViewModel.Recipe.TotalTime</span>
                }
                @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.CookingTemperature))
                {
                    <span class="recipe-meta-pill">Temp: @ViewModel.Recipe.CookingTemperature</span>
                }
            </div>
        }

        @{
            var ingredients = ViewModel.BuildIngredients().ToList();
        }
        @if (ingredients.Any())
        {
            <section>
                <h3 class="mb-2">Ingredients</h3>
                <p class="ingredient-checklist-hint">Tap an ingredient to check it off</p>
                <ul class="ingredient-checklist">
                    @for (var i = 0; i < ingredients.Count; i++)
                    {
                        var idx = i;
                        var item = ingredients[idx];
                        var isChecked = ViewModel.CheckedIngredients.Contains(idx);
                        <li class="ingredient-check-item @(isChecked ? "ingredient-checked" : "")"
                            @onclick="() => ViewModel.ToggleIngredient(idx)">
                            <span class="ingredient-check-box">@(isChecked ? "&#10003;" : "")</span>
                            @if (!string.IsNullOrWhiteSpace(item.Quantity))
                            {
                                <span class="ingredient-detail-qty">@item.Quantity</span>
                            }
                            <span>@item.Ingredient</span>
                        </li>
                    }
                </ul>
                @if (ViewModel.CheckedIngredients.Count > 0)
                {
                    <button class="btn btn-outline-secondary btn-sm mt-2" type="button" @onclick="ViewModel.ClearChecked">
                        Clear checked (@ViewModel.CheckedIngredients.Count)
                    </button>
                }
            </section>
        }

        @if (RecipeDetailsViewModel.HasItems(ViewModel.Recipe.Equipment))
        {
            <section>
                <button class="recipe-section-toggle" type="button" @onclick="ViewModel.ToggleEquipment">
                    <h3 class="d-inline mb-0">Equipment</h3>
                    <span class="toggle-chevron">@(ViewModel.ShowEquipment ? "&#9650;" : "&#9660;")</span>
                </button>
                @if (ViewModel.ShowEquipment)
                {
                    <ul class="mt-2">
                        @foreach (var item in ViewModel.Recipe.Equipment.Where(RecipeDetailsViewModel.HasText))
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
            </section>
        }

        @if (RecipeDetailsViewModel.HasItems(ViewModel.Recipe.Instructions))
        {
            <section>
                <h3 class="mb-3">Instructions</h3>
                <div class="step-list">
                    @{
                        var steps = ViewModel.Recipe.Instructions.Where(RecipeDetailsViewModel.HasText).ToList();
                    }
                    @for (var i = 0; i < steps.Count; i++)
                    {
                        var stepNum = i + 1;
                        <div class="step-card">
                            <div class="step-number">@stepNum</div>
                            <div class="step-text">@steps[i]</div>
                        </div>
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.NutritionFacts))
        {
            <section>
                <button class="recipe-section-toggle" type="button" @onclick="ViewModel.ToggleNutrition">
                    <h3 class="d-inline mb-0">Nutrition</h3>
                    <span class="toggle-chevron">@(ViewModel.ShowNutrition ? "&#9650;" : "&#9660;")</span>
                </button>
                @if (ViewModel.ShowNutrition)
                {
                    <p class="mt-2">@ViewModel.Recipe.NutritionFacts</p>
                }
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(ViewModel.Recipe.StorageInfo))
        {
            <section>
                <button class="recipe-section-toggle" type="button" @onclick="ViewModel.ToggleStorage">
                    <h3 class="d-inline mb-0">Storage</h3>
                    <span class="toggle-chevron">@(ViewModel.ShowStorage ? "&#9650;" : "&#9660;")</span>
                </button>
                @if (ViewModel.ShowStorage)
                {
                    <p class="mt-2">@ViewModel.Recipe.StorageInfo</p>
                }
            </section>
        }

    </div>
}

@code {
    [Parameter]
    public int RecipeId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await ViewModel.LoadRecipeAsync(RecipeId);
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
    }
}
