<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CookbookMauiBlazor"
             xmlns:shared="clr-namespace:CookbookMauiBlazor.Shared;assembly=CookbookMauiBlazor.Shared"
             x:Class="CookbookMauiBlazor.MainPage"
             BackgroundColor="White"
             Padding="0">

    <BlazorWebView x:Name="blazorWebView"
                   HostPage="wwwroot/index.html"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app"
                           ComponentType="{x:Type shared:Routes}"/>
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
