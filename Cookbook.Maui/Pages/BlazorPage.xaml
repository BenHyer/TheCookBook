<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:shared="clr-namespace:Cookbook.Shared.Hybrid;assembly=Cookbook.Shared"
             x:Class="Cookbook.Maui.Pages.BlazorPage"
             Title="Cookbook"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    <Grid RowDefinitions="*" Padding="0">
        <blazor:BlazorWebView x:Name="blazorWebView" 
                             HostPage="wwwroot/index.html"
                             Grid.Row="0">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type shared:Root}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</ContentPage>
