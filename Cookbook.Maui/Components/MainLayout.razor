@inherits LayoutComponentBase
@using Cookbook.Shared.Boards

<div class="page">
    <div class="sidebar">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="boards">
                    <span class="oi oi-list" aria-hidden="true"></span> Boards
                </NavLink>
            </div>
        </nav>
    </div>

    <div class="main">
        <div class="content px-4">
            @Body
        </div>
    </div>
</div>

<style>
    .page {
        display: flex;
        height: 100%;
    }

    .sidebar {
        width: 250px;
        background-color: #f7f7f7;
        border-right: 1px solid #e0e0e0;
        padding: 20px 0;
    }

    .flex-column {
        display: flex;
        flex-direction: column;
    }

    .nav-item {
        padding: 10px 20px;
    }

    .nav-link {
        color: inherit;
        text-decoration: none;
    }

    .nav-link:hover {
        background-color: #e0e0e0;
        border-radius: 4px;
    }

    .nav-link.active {
        color: #0078d4;
        font-weight: bold;
    }

    .main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .px-4 {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
    }

    .px-3 {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .oi {
        margin-right: 8px;
    }
</style>
