@page "/boards"
@using Cookbook.Shared.Boards
@inject IBoardService BoardService

<PageTitle>Boards</PageTitle>

<div class="container">
    <h1>Recipe Boards</h1>
    
    <div class="board-section">
        <h2>Create New Board</h2>
        <CreateBoardForm />
    </div>

    <div class="board-section">
        <h2>Your Boards</h2>
        <BoardList />
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    h1 {
        color: #333;
        margin-bottom: 20px;
    }

    .board-section {
        margin-bottom: 40px;
        padding: 20px;
        background-color: #fafafa;
        border-radius: 4px;
    }

    .board-section h2 {
        color: #0078d4;
        border-bottom: 2px solid #0078d4;
        padding-bottom: 10px;
    }
</style>
